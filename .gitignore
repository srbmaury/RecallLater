# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# native module build output
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# E2E run output
e2e/out/

# Secrets (API keys) — never commit
.env
.env.*
!.env.example
